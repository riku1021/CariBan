{
  "name": "cariban-react-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "dotenvx run -f envs/.env.dev --no-native -- vite --mode dev",
    "build": "tsc -b && dotenvx run -f envs/.env.prod --no-native -- vite build --mode prod",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "lint:fix": "biome check --write .",
    "preview": "tsc -b && dotenvx run -f envs/.env.prod --no-native -- vite build --mode prod && dotenvx run -f envs/.env.prod --no-native -- vite preview",
    "preview:serve": "dotenvx run -f envs/.env.prod --no-native -- vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "panda codegen"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.13.3",
    "@react-spring/web": "^9.7.5",
    "@tanstack/react-query": "^5.96.0",
    "@tanstack/react-router": "^1.114.34",
    "@use-gesture/react": "^10.3.1",
    "axios": "^1.12.2",
    "jotai": "^2.12.2",
    "jotai-tanstack-query": "^0.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@dotenvx/dotenvx": "^2.21.0",
    "@pandacss/dev": "^1.3.1",
    "@tanstack/react-query-devtools": "^5.96.0",
    "@tanstack/react-router-devtools": "^1.114.34",
    "@tanstack/router-plugin": "^1.114.34",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.33.0"
}
