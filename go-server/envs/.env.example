# =============================================================================
# サーバー用環境変数の例
# 正本は暗号化された envs/.env.dev / envs/.env.prod（dotenvx）
# 初回: README の環境変数節を参照
# =============================================================================

# --- サーバー ---
# アプリの待ち受け（コンテナ内）。Compose も既定で 8000。
# ブラウザ向けの 80 は Nginx が公開し、/api をここへプロキシするため PORT を 80 に変えないこと。
PORT=8000
HOST=0.0.0.0
READ_TIMEOUT=30
WRITE_TIMEOUT=30
ENV=dev

# ログレベル: DEBUG / INFO / WARN / ERROR（別名は受け付けない）
# 未設定時は ENV=prod なら INFO、それ以外は DEBUG
LOG_LEVEL=DEBUG

# --- Database ---
# ホストから Docker の PostgreSQL（compose の user/db と一致）へ接続する例
# compose デフォルト: user=app, password=app, db=cariban
DATABASE_URL=postgres://app:app@localhost:5432/cariban?sslmode=disable
# Docker Compose 起動時は compose 側の environment で
# `postgres://…@postgres:5432/…` に上書きされます。

# --- Security Headers ---
ENABLE_HSTS=false
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
X_FRAME_OPTIONS=DENY
CSP_POLICY=default-src 'self'; script-src 'none'; object-src 'none';
PERMISSIONS_POLICY="geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), accelerometer=(), gyroscope=(), fullscreen=(), autoplay=()"
